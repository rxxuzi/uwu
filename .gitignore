# Whitelist .gitignore — ignore everything, then re-include only the trees we track.
# Re-includes are SCOPED to specific directories (not global file types), so anything
# not listed — target/, archive/, doc/, CLAUDE.md, any stray file or new folder — is
# ignored by DEFAULT. There is nothing to remember to exclude.
#
#   *          ignore everything
#   !*/        let git descend into subdirectories (required to reach nested files)
#   !/dir/**   re-include one tracked tree

# ignore everything
*

# descend into every directory (so the re-includes below can reach nested files)
!*/

# root files we keep
!/.gitignore
!/README.md
!/LICENSE*
!/Cargo.toml
!/Cargo.lock

# the trees we track: the source (code + embedded png/ico assets) and the tests
!/src/**
!/tests/**
